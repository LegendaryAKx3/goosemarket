{
  "version": 2,
  "env": {
    "PIP_BREAK_SYSTEM_PACKAGES": "1"
  },
  "buildCommand": "npm install --include=dev && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/dist/index.html" }
  ]
}
